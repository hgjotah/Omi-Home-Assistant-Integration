{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omi-home-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "minify": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  },
  "secrets": {
    "required": ["APP_SECRET", "OMI_WEBHOOK_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omi-home-assistant-db",
      "database_id": "3993c61c-c3cb-43dd-af22-6a68991bf60f",
      "migrations_dir": "migrations"
    }
  ]
}
