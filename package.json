{
  "name": "omi-home-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Omi Real-Time Transcript to local Home Assistant through a Cloudflare D1 queue and ESP32-C6 bridge",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "fake-bridge": "tsx tools/fake-bridge.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^10.0.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
